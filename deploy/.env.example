# Скопировать в deploy/.env на сервере и заполнить. В git не коммитится.
DOMAIN=shazram.ru
ACME_EMAIL=admin@shazram.ru

# Доступ к списку студентов. Хэш генерируется так:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'ВАШ_ПАРОЛЬ'
BASIC_AUTH_USER=curator
BASIC_AUTH_HASH=$2a$14$замените_на_свой_хэш

RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
